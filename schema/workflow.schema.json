{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:armadra:ama-workflow:2",
  "title": "Workflow",
  "description": "A multi-agent workflow (format version 2). Cross-field rules (references exist, no cycles, collect from is a subset of after, contract.owns globs and overlaps, maxRetries needs verify) need validateWorkflow() in addition to this schema.",
  "type": "object",
  "properties": {
    "version": {
      "const": 2
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 4000
    },
    "params": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/param"
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "links": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "contract": {
      "anyOf": [
        {
          "$ref": "#/$defs/contract"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "title",
    "roles",
    "steps"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
    },
    "param": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "string",
            "path",
            "text"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        },
        "default": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "agentId": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9-]{0,63}|custom:[^\\r\\n]{1,64}|acp:\\S{1,128})$"
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        },
        "permissionMode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "default",
            "auto-edit",
            "full-auto",
            "plan"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120
        },
        "worktree": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "tier": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "light",
            "standard",
            "strong",
            "max"
          ]
        }
      },
      "required": [
        "id",
        "agentId"
      ],
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "peer",
            "supervises"
          ]
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "commands": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "checklist": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "At least one command or checklist item is required."
    },
    "contract": {
      "type": "object",
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 6000
        },
        "owns": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "At least one of text and owns is required."
    },
    "source": {
      "type": "object",
      "properties": {
        "boardId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "nodeIds": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 64,
          "items": {
            "type": "string"
          }
        },
        "proposedBy": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/promptStep"
        },
        {
          "$ref": "#/$defs/collectStep"
        },
        {
          "$ref": "#/$defs/gateStep"
        }
      ]
    },
    "promptStep": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "prompt"
        },
        "role": {
          "$ref": "#/$defs/id"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "after": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "role",
        "prompt"
      ],
      "additionalProperties": false
    },
    "collectStep": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "collect"
        },
        "role": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "after": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "verify": {
          "anyOf": [
            {
              "$ref": "#/$defs/verify"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxRetries": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "id",
        "kind",
        "role",
        "from",
        "prompt"
      ],
      "additionalProperties": false
    },
    "gateStep": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "gate"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "after": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ],
      "additionalProperties": false
    }
  }
}
